# ==============================================================================
# File Upload Service SDK Environment Configurations
# ==============================================================================
# Copy these environment variables to your application's .env file to enable
# out-of-the-box configuration for the FileUploadClient.
# ==============================================================================

# The base URL of the deployed File Upload microservice
FILE_SERVICE_URL=http://localhost:4001

# Shared gateway authentication HMAC secret (must match the backend's GATEWAY_INTERNAL_SECRET)
# Used by the SDK to sign requests automatically, resolving permissions.
FILE_SERVICE_HMAC_SECRET=generate_with_openssl_rand_hex_32

# Default multi-tenancy tenant context
FILE_SERVICE_TENANT_ID=easydev

# Default fallback user context parameters
FILE_SERVICE_USER_ID=anonymous
FILE_SERVICE_USER_ROLE=anonymous
FILE_SERVICE_USER_EMAIL=
FILE_SERVICE_USER_NAME=
