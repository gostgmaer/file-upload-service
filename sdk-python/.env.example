# ==============================================================================
# File Upload Service Python SDK — environment configuration
# Copy into your application's .env. Only FILE_SERVICE_URL is a real
# deploy-time setting; identity (tenant/user) is per-request and is NOT
# read from the environment — see README.md "Identity model".
# ==============================================================================

# The base URL of the deployed File Upload microservice
FILE_SERVICE_URL=http://localhost:4001

# Optional. NOT currently enforced server-side — /api/files/* skips gateway
# signature verification entirely (see file-upload-service/app.js). Set this
# only if/when that changes; there's no need to keep it in sync across
# deployments today, and admin-only routes are gated by the plain
# X-User-Role: admin header value, not by this secret.
FILE_SERVICE_HMAC_SECRET=
